// =============================================================================
// PRISMA CONFIGURATION
// Core Service - Modular Monolith
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// MODULE: AUTH / OTP
// =============================================================================

model PhoneOtp {
  id        String   @id @default(uuid())
  phone     String   @map("phone")
  otpHash   String   @map("otp_hash")
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")

  createdAt  DateTime  @default(now()) @map("created_at")
  verifiedAt DateTime? @map("verified_at")

  @@index([phone])
  @@index([phone, expiresAt])
  @@index([expiresAt])
  @@map("phone_otps")
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("email_otps")
}

// =============================================================================
// MODULE: USERS
// =============================================================================

model User {
  id                String    @id @default(uuid())
  email             String?   @unique
  phone             String?   @unique
  refreshTokenHash  String?   @map("refresh_token_hash")
  isVerified        Boolean   @default(false) @map("is_verified")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  profile   UserProfile?
  portfolio Portfolio?
  accounts  Account[]
  goals     Goal[]
  budgets   Budget[]
  sips      SIP[]
  insights  Insight[]
  onboardingState UserOnboardingState?
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

enum OnboardingStatus {
  NEW
  IN_PROGRESS
  COMPLETE
}

model UserOnboardingState {
  id                 String            @id @default(uuid())
  userId             String            @unique @map("user_id")

  profileCompleted   Boolean           @default(false) @map("profile_completed")
  accountsCompleted  Boolean           @default(false) @map("accounts_completed")
  portfolioCompleted Boolean           @default(false) @map("portfolio_completed")

  onboardingStatus   OnboardingStatus  @default(NEW) @map("onboarding_status")

  lastUpdatedAt DateTime @updatedAt @map("last_updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_onboarding_states")
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")

  name        String
  dateOfBirth DateTime? @map("date_of_birth")
  age         Int?
  occupation  String?

  monthlyIncome   Decimal? @map("monthly_income") @db.Decimal(15, 2)
  monthlyExpenses Decimal? @map("monthly_expenses") @db.Decimal(15, 2)
  dependents      Int      @default(0)

  riskProfile          String? @map("risk_profile")
  investmentExperience String? @map("investment_experience")

  retirementAge          Int?     @map("retirement_age")
  retirementTargetAmount Decimal? @map("retirement_target_amount") @db.Decimal(15, 2)

  liabilities Json?
  assets      Json?    // For Savings, Real Estate, etc.
  insurance   Json?

  monthlySipAmount Decimal? @map("monthly_sip_amount") @db.Decimal(15, 2)

  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  hasEcasData         Boolean @default(false) @map("has_ecas_data")

  // New fields for Onboarding Flow
  maritalStatus String? @map("marital_status")
  children      Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// =============================================================================
// ONBOARDING
// =============================================================================

model OnboardingQuestion {
  id           String  @id @default(uuid())
  order        Int     @unique
  text         String
  type         String  // "slider", "choice", "input"
  fieldMapping String  @map("field_mapping") // e.g. "monthlyIncome", "riskProfile"
  
  // Configuration for UI
  options      Json?   // For "choice": ["Single", "Married"]
  min          Float?  // For "slider"
  max          Float?  // For "slider"
  step         Float?  // For "slider"
  unit         String? // e.g. "₹", "years"
  
  description  String? // Helper text
  
  isActive     Boolean @default(true) @map("is_active")

  @@map("onboarding_questions")
}

// =============================================================================
// BANK ACCOUNTS & TRANSACTIONS
// =============================================================================
model Account {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  accountName     String    @map("account_name")
  institutionName String    @map("institution_name")
  accountType     String    @map("account_type")

  currentBalance Decimal @default(0) @map("current_balance") @db.Decimal(15, 2)

  aggregatorId String?   @map("aggregator_id")
  lastSyncedAt DateTime? @map("last_synced_at")

  isActive  Boolean   @default(true) @map("is_active")
  isPrimary Boolean   @default(false) @map("is_primary")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  accountId String?  @map("account_id")

  amount      Decimal @db.Decimal(15, 2)
  type        String
  category    String
  subcategory String?

  merchantName String? @map("merchant_name")
  description  String?

  isRecurring Boolean @default(false) @map("is_recurring")
  transactionDate DateTime @map("transaction_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, transactionDate])
  @@index([userId, category])
  @@map("transactions")
}

// =============================================================================
// BUDGETS
// =============================================================================

model Budget {
  id     String @id @default(uuid())
  userId String @map("user_id")

  name         String
  category     String
  budgetAmount Decimal @map("budget_amount") @db.Decimal(15, 2)
  spentAmount  Decimal @default(0) @map("spent_amount") @db.Decimal(15, 2)

  period    String   @default("monthly")
  startDate DateTime @map("start_date")
  endDate   DateTime? @map("end_date")

  alertThreshold Int     @default(80) @map("alert_threshold")
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("budgets")
}

// =============================================================================
// PORTFOLIO & INVESTMENTS
// =============================================================================

model Portfolio {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  totalValue    Decimal @default(0) @map("total_value") @db.Decimal(15, 2)
  totalInvested Decimal @default(0) @map("total_invested") @db.Decimal(15, 2)

  fixedDeposits Decimal @default(0) @map("fixed_deposits") @db.Decimal(15, 2)
  epf           Decimal @default(0) @db.Decimal(15, 2)
  ppf           Decimal @default(0) @db.Decimal(15, 2)
  nps           Decimal @default(0) @db.Decimal(15, 2)

  cash       Decimal @default(0) @db.Decimal(15, 2)
  gold       Decimal @default(0) @db.Decimal(15, 2)
  realEstate Decimal @default(0) @map("real_estate") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mutualFunds MutualFundHolding[]
  stocks      StockHolding[]

  @@map("portfolios")
}

model MutualFundHolding {
  id          String @id @default(uuid())
  portfolioId String @map("portfolio_id")

  schemeName String  @map("scheme_name")
  isin       String?
  amc        String?
  folioNumber String? @map("folio_number")
  category   String?

  units Decimal @default(0) @db.Decimal(15, 4)
  nav   Decimal @default(0) @db.Decimal(15, 4)

  currentValue  Decimal @default(0) @map("current_value") @db.Decimal(15, 2)
  investedValue Decimal @default(0) @map("invested_value") @db.Decimal(15, 2)

  gainAbsolute   Decimal @default(0) @map("gain_absolute") @db.Decimal(15, 2)
  gainPercentage Decimal @default(0) @map("gain_percentage") @db.Decimal(8, 4)

  fundType String? @map("fund_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([isin])
  @@map("mutual_fund_holdings")
}

model StockHolding {
  id          String @id @default(uuid())
  portfolioId String @map("portfolio_id")

  symbol      String
  companyName String? @map("company_name")

  quantity     Int     @default(0)
  averagePrice Decimal @default(0) @map("average_price") @db.Decimal(15, 2)

  currentPrice Decimal @default(0) @map("current_price") @db.Decimal(15, 2)
  investedValue Decimal @default(0) @map("invested_value") @db.Decimal(15, 2)
  currentValue  Decimal @default(0) @map("current_value") @db.Decimal(15, 2)

  gainAbsolute   Decimal @default(0) @map("gain_absolute") @db.Decimal(15, 2)
  gainPercentage Decimal @default(0) @map("gain_percentage") @db.Decimal(8, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([symbol])
  @@map("stock_holdings")
}

// =============================================================================
// SIP
// =============================================================================

model SIP {
  id     String @id @default(uuid())
  userId String @map("user_id")

  name     String
  fundIsin String? @map("fund_isin")
  fundName String? @map("fund_name")

  amount     Decimal @db.Decimal(15, 2)
  frequency  String  @default("monthly")
  dayOfMonth Int     @map("day_of_month")

  totalInvested    Decimal @default(0) @map("total_invested") @db.Decimal(15, 2)
  installmentsPaid Int     @default(0) @map("installments_paid")

  startDate DateTime @map("start_date")
  endDate   DateTime? @map("end_date")
  nextDate  DateTime @map("next_date")

  goalId String? @map("goal_id")
  status String @default("active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("sips")
}

// =============================================================================
// GOALS
// =============================================================================

model Goal {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String? @map("image_url")

  category String
  priority String @default("medium")

  targetAmount  Decimal @map("target_amount") @db.Decimal(15, 2)
  currentAmount Decimal @default(0) @map("current_amount") @db.Decimal(15, 2)

  deadline  DateTime
  startDate DateTime @default(now()) @map("start_date")

  inflationRate Decimal  @default(6) @map("inflation_rate") @db.Decimal(5, 2)
  futureValue   Decimal? @map("future_value") @db.Decimal(15, 2)

  requiredMonthly Decimal? @map("required_monthly") @db.Decimal(15, 2)

  progressPercent Decimal @default(0) @map("progress_percent") @db.Decimal(5, 2)
  status          String  @default("active")

  linkedInvestments String[] @default([]) @map("linked_investments")
  linkedSipIds      String[] @default([]) @map("linked_sip_ids")

  isShared   Boolean  @default(false) @map("is_shared")
  sharedWith String[] @default([]) @map("shared_with")

  notes String?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  deletedAt   DateTime? @map("deleted_at")

  progressHistory GoalProgress[]
  milestones      GoalMilestone[]

  @@index([userId, status])
  @@index([userId, category])
  @@index([deadline])
  @@map("goals")
}

model GoalProgress {
  id     String @id @default(uuid())
  goalId String @map("goal_id")

  amount     Decimal @db.Decimal(15, 2)
  change     Decimal @db.Decimal(15, 2)
  changeType String  @map("change_type")

  progressPercent Decimal @map("progress_percent") @db.Decimal(5, 2)

  source        String  @default("manual")
  transactionId String? @map("transaction_id")

  note       String?
  recordedAt DateTime @default(now()) @map("recorded_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, recordedAt])
  @@map("goal_progress")
}

model GoalMilestone {
  id     String @id @default(uuid())
  goalId String @map("goal_id")

  name         String
  percentage   Int
  targetAmount Decimal @map("target_amount") @db.Decimal(15, 2)

  reached   Boolean   @default(false)
  reachedAt DateTime? @map("reached_at")

  celebrationShown Boolean @default(false) @map("celebration_shown")

  createdAt DateTime @default(now()) @map("created_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, percentage])
  @@map("goal_milestones")
}

model GoalTemplate {
  id String @id @default(uuid())

  name        String
  description String
  category    String
  iconUrl     String? @map("icon_url")

  defaultAmount        Decimal? @map("default_amount") @db.Decimal(15, 2)
  defaultTimelineYears Int?     @map("default_timeline_years")

  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("goal_templates")
}


//
// INSIGHTS
//

enum InsightCategory {
  portfolio
  cashflow
  goal
  tax
  risk
}

enum InsightSeverity {
  high
  medium
  low
}

enum InsightTone {
  success
  warning
  danger
}

model Insight {
  /// Rule-level insight identifier (not auto-generated)
  id        String
  userId    String   @map("user_id")

  category  InsightCategory
  severity  InsightSeverity
  tone      InsightTone

  title     String
  message   String

  data      Json?
  action    String?

  isActive  Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId])
}
